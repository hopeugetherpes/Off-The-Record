{
  "name": "off-the-record",
  "version": "1.0.0",
  "description": "A public-space file-sharing archive built as a static Next.js site.",
  "private": true,
  "license": "CC0-1.0",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "typecheck": "tsc --noEmit",
    "audit": "pnpm audit --prod"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-simple-maps": "^5.0.5",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "5.7.3"
  }
}
